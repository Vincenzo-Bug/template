# Safe development-only examples. Never put real credentials in this file.
SERVICE_ENVIRONMENT=development
SERVICE_APP_NAME=Service Template
SERVICE_APP_VERSION=0.1.0
SERVICE_LOG_LEVEL=INFO
SERVICE_LOG_JSON=true
SERVICE_DEBUG=false

# These values are intentionally local and invalid outside Docker Compose.
SERVICE_DATABASE_URL=postgresql+asyncpg://service_dev:service_dev_only@postgres:5432/service
SERVICE_DATABASE_ECHO=false
SERVICE_DATABASE_POOL_SIZE=5
SERVICE_DATABASE_MAX_OVERFLOW=5
SERVICE_DATABASE_CONNECT_TIMEOUT_SECONDS=5

SERVICE_REDIS_URL=redis://redis:6379/0
SERVICE_READINESS_TIMEOUT_SECONDS=2
SERVICE_CORS_ORIGINS=
